# PoloDeck — Docker Compose environment (copy to .env or run setup/setup.sh).
# Compose loads .env from the setup/ directory when you run commands there.

# Bind address for published ports (API :3000, web-app :8080).
# 127.0.0.1 = localhost only. 0.0.0.0 = all interfaces (LAN / ESP32-S3 displays).
POLODECK_BIND_ADDRESS=0.0.0.0

# Postgres (defaults match docker-compose.yml).
POSTGRES_USER=polodeck
POSTGRES_PASSWORD=polodeck
POSTGRES_DB=polodeck

# Build-time URLs baked into the web-app static bundle (browser → API).
# Recommended for Docker on this machine (open http://localhost:8080):
VITE_API_URL=/api
VITE_SOCKET_URL=
# Only use LAN :3000 URLs if the UI is served without the :8080 nginx proxy (unusual).
# VITE_API_URL=http://<your-machine-LAN-IP>:3000/api
# VITE_SOCKET_URL=http://<your-machine-LAN-IP>:3000
