NODE_ENV=development
PORT=3000
# Listen address (native packages use 127.0.0.1 or 0.0.0.0 from setup wizard)
HOST=0.0.0.0

# Database
POSTGRES_USER=polodeck
POSTGRES_PASSWORD=polodeck
POSTGRES_DB=polodeck
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql://polodeck:polodeck@localhost:5432/polodeck?schema=public

# Native packaging (leave unset for Docker / local API-only dev)
# POLODECK_WEB_ROOT=/path/to/web-app/dist
# POLODECK_UI_PORT=8080
# POLODECK_REQUIRE_SETUP=true
# POLODECK_VERSION=0.1.0
# POLODECK_SESSION_SECRET=change-me
# POLODECK_CONFIG_ENV_PATH=/path/to/polodeck.env
